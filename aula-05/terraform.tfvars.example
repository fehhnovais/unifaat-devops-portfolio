# ==============================================================
# Copie este arquivo para terraform.tfvars e preencha os valores
# ATENÇÃO: terraform.tfvars está no .gitignore — não será commitado
# ==============================================================

# Região AWS
aws_region = "us-east-1"

# Nome do projeto
project_name = "technova"

# Rede
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidr   = "10.0.1.0/24"
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
availability_zones   = ["us-east-1a", "us-east-1b"]

# EC2
ec2_instance_type = "t2.micro"
ec2_key_name      = "technova-key"
allowed_ssh_cidr  = "0.0.0.0/0"   # ⚠️ Restrinja ao seu IP em produção: "X.X.X.X/32"

# RDS
db_name              = "technovadb"
db_username          = "dbadmin"
db_password          = "TrocaPorSenhaForte123!"   # ⚠️ MUDE ISSO!
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
db_engine_version    = "15"

# Estado remoto (preencha após rodar o apply do backend/)
# aws sts get-caller-identity --query Account --output text
state_bucket_name    = "technova-terraform-state-SEU-ACCOUNT-ID"
state_dynamodb_table = "technova-terraform-locks"
